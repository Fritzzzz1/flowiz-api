# Development Dockerfile with hot reload

FROM node:18-alpine

WORKDIR /app

# Install dumb-init
RUN apk add --no-cache dumb-init

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev)
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 3001

# Use dumb-init
ENTRYPOINT ["dumb-init", "--"]

# Start dev server with hot reload
CMD ["npm", "run", "dev"]
